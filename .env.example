# Copy this file to .env and fill in real values. Never commit .env itself.

# Google login (used by login_daily_check.spec.ts)
GOOGLE_EMAIL=
GOOGLE_PASSWORD=

# Telegram bot (telegram-bot/bot.js)
TELEGRAM_BOT_TOKEN=

# Postgres — staging, used by tests/standard/lib/db.ts and db-staging-direct.ts
DB_HOST=
DB_PORT=6432
DB_STAGING_DIRECT_PORT=5432
DB_USER=readonly
DB_PASSWORD=
DB_NAME=football

# Postgres — production, used by several tests/*.spec.ts files
DB_PROD_HOST=
DB_PROD_PASSWORD=

# MongoDB — footystats cache (tests/standard/lib/mongo.ts)
MONGO_HOST=
MONGO_USER=readonly
MONGO_PASSWORD=

# MongoDB — mapping check script (scripts/check_mongo_mapping.mjs)
MONGO_MAPPING_HOST=
MONGO_MAPPING_USER=readonly
MONGO_MAPPING_PASSWORD=

# MQTT broker — host + password (tests/check_socket.spec.ts, tests/var_outcome_socket_check.spec.ts)
MQTT_HOST=
MQTT_PASSWORD=
